<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>4Cats Camp Check-In</title>
<link rel="icon" type="image/svg+xml" href="https://cdn.shopify.com/s/files/1/1451/3756/files/favicon.png?v=1613591354">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;background:#f5f5f0;color:#1a1a1a;min-height:100vh;-webkit-text-size-adjust:100%}

/* LOGIN */
#login-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem}
.login-card{background:white;border-radius:16px;border:0.5px solid #e0e0d8;padding:2rem;width:100%;max-width:380px}
.login-card h1{font-size:22px;font-weight:500;margin-bottom:4px;text-align:center}
.login-card p{font-size:14px;color:#888;margin-bottom:1.5rem;text-align:center}
.login-card input{width:100%;padding:12px 14px;border:0.5px solid #d0d0c8;border-radius:10px;font-size:16px;margin-bottom:12px;outline:none;display:block;-webkit-appearance:none}
.login-card input:focus{border-color:#888}
.login-card button{width:100%;padding:13px;background:#1a1a1a;color:white;border:none;border-radius:10px;font-size:16px;cursor:pointer}
.error-msg{color:#c0392b;font-size:13px;margin-top:8px;display:none}

/* APP HEADER */
#app-screen{display:none}
.app-header{background:white;border-bottom:0.5px solid #e0e0d8;padding:10px 16px;position:sticky;top:0;z-index:100}
.header-row1{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.header-title{font-size:17px;font-weight:600;color:#1a1a1a}
.header-sub{font-size:12px;color:#888}
.date-nav{display:flex;align-items:center;gap:8px}
.date-nav button{background:white;border:0.5px solid #d0d0c8;border-radius:8px;padding:6px 10px;font-size:14px;cursor:pointer;color:#1a1a1a}
.date-nav button:active{background:#f5f5f0}
.date-nav input[type=date]{border:0.5px solid #d0d0c8;border-radius:8px;padding:6px 10px;font-size:14px;background:white;color:#1a1a1a;-webkit-appearance:none}
.today-btn{font-size:12px;padding:5px 10px;background:#f5f5f0}

/* TABS */
.tabs{display:flex;background:white;border-bottom:0.5px solid #e0e0d8;overflow-x:auto;-webkit-overflow-scrolling:touch}
.tab-btn{flex:1;min-width:120px;padding:11px 8px;font-size:13px;font-weight:500;border:none;background:none;cursor:pointer;color:#888;border-bottom:2px solid transparent;white-space:nowrap}
.tab-btn.active{color:#1a1a1a;border-bottom-color:#1a1a1a}

/* CONTENT */
.tab-content{display:none;padding:14px 14px 80px}
.tab-content.active{display:block}

/* SESSION SELECTOR */
.session-pills{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.session-pill{padding:6px 14px;border-radius:20px;font-size:13px;font-weight:500;border:1.5px solid #d0d0c8;background:white;cursor:pointer;color:#555}
.session-pill.active{background:#1a1a1a;color:white;border-color:#1a1a1a}
.session-pill.am{border-color:#0F6E56}
.session-pill.am.active{background:#0F6E56;border-color:#0F6E56}
.session-pill.pm{border-color:#3C3489}
.session-pill.pm.active{background:#3C3489;border-color:#3C3489}

/* STATS BAR */
.stats-bar{display:flex;gap:10px;margin-bottom:14px}
.stat-card{background:white;border:0.5px solid #e0e0d8;border-radius:10px;padding:8px 14px;flex:1;text-align:center}
.stat-num{font-size:22px;font-weight:500}
.stat-label{font-size:11px;color:#888;margin-top:1px}

/* DAY PLAN BANNER */
.day-plan-banner{background:white;border:0.5px solid #e0e0d8;border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.day-plan-label{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px}
.day-plan-text{font-size:14px;font-weight:500;color:#1a1a1a}
.day-plan-link{font-size:12px;color:#5b4fcf;text-decoration:none;margin-left:6px}

/* SEARCH + SORT */
.controls-row{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center}
.search-input{flex:1;min-width:180px;padding:9px 12px;border:0.5px solid #d0d0c8;border-radius:10px;font-size:16px;background:white;color:#1a1a1a;-webkit-appearance:none;outline:none}
.sort-group{display:flex;gap:4px}
.sort-btn{padding:8px 12px;font-size:13px;border:0.5px solid #d0d0c8;border-radius:8px;background:white;color:#888;cursor:pointer;white-space:nowrap}
.sort-btn.active{background:#1a1a1a;color:white;border-color:#1a1a1a}

/* ROSTER CARDS — iPad-friendly big tap targets */
.roster-list{display:flex;flex-direction:column;gap:8px}
.roster-card{background:white;border:0.5px solid #e0e0d8;border-radius:12px;overflow:hidden;transition:box-shadow .1s}
.roster-card.checked-in{border-left:4px solid #3B6D11}
.roster-card.has-medical{border-right:4px solid #BA7517}
.roster-card-header{display:flex;align-items:center;gap:12px;padding:12px 14px}
.check-btn{width:38px;height:38px;border-radius:8px;border:2px solid #d0d0c8;background:white;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;transition:all .15s;-webkit-tap-highlight-color:transparent}
.check-btn.checked{background:#3B6D11;border-color:#3B6D11;color:white}
.check-btn:not(.checked){color:transparent}
.child-info{flex:1;min-width:0}
.child-name{font-size:16px;font-weight:500;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.child-meta{font-size:12px;color:#888;margin-top:1px}
.card-badges{display:flex;gap:6px;align-items:center;flex-shrink:0}
.session-tag{font-size:11px;font-weight:500;padding:3px 8px;border-radius:12px}
.session-tag.am{background:#E1F5EE;color:#0F6E56}
.session-tag.pm{background:#EEEDFE;color:#3C3489}
.session-tag.fd{background:#E6F1FB;color:#185FA5}
.aftercare-tag{font-size:11px;padding:3px 7px;border-radius:12px;background:#FEF3C7;color:#92400E;font-weight:500}
.walkhome-tag{font-size:11px;padding:3px 7px;border-radius:12px;background:#FEE2E2;color:#991B1B;font-weight:500}
.medical-icon{font-size:18px;cursor:pointer;-webkit-tap-highlight-color:transparent}

/* CARD BODY — expandable fields */
.roster-card-body{padding:0 14px 12px;display:flex;gap:10px;flex-wrap:wrap}
.field-group{display:flex;flex-direction:column;gap:3px}
.field-label{font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:.05em}
.field-input{padding:7px 10px;border:0.5px solid #e0e0d8;border-radius:8px;font-size:15px;background:#fafaf8;color:#1a1a1a;width:100%;outline:none;-webkit-appearance:none}
.field-input:focus{border-color:#888;background:white}
.table-input{width:70px}
.badge-select{min-width:160px;font-size:14px}
.badge-select option.previously-awarded{color:#bbb}
.save-row-btn{padding:7px 16px;background:#1a1a1a;color:white;border:none;border-radius:8px;font-size:13px;cursor:pointer;align-self:flex-end;white-space:nowrap}
.save-row-btn.saved{background:#3B6D11}

/* MEDICAL MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:500;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal-card{background:white;border-radius:16px;padding:20px;max-width:400px;width:100%;max-height:80vh;overflow-y:auto}
.modal-card h3{font-size:17px;font-weight:600;margin-bottom:12px}
.modal-row{display:flex;flex-direction:column;gap:2px;margin-bottom:10px}
.modal-label{font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:.05em}
.modal-value{font-size:14px;color:#1a1a1a}
.modal-close{width:100%;padding:12px;background:#f5f5f0;border:none;border-radius:10px;font-size:15px;cursor:pointer;margin-top:8px}

/* CEREMONY TAB */
.ceremony-wrap{display:flex;flex-direction:column;align-items:center;padding:10px 0 40px}
.ceremony-group{width:100%;max-width:480px;margin-bottom:32px}
.ceremony-group-title{font-size:15px;font-weight:600;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.ceremony-group-time{font-size:12px;color:#888;font-weight:400}
.wheel-wrap{position:relative;width:320px;height:320px;margin:0 auto 16px}
canvas{border-radius:50%;display:block}
.wheel-pointer{position:absolute;top:-8px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:11px solid transparent;border-right:11px solid transparent;border-top:22px solid #D85A30}
.spin-btn{display:block;width:200px;margin:0 auto 12px;padding:14px;font-size:16px;font-weight:500;border:none;border-radius:12px;background:#1a1a1a;color:white;cursor:pointer;-webkit-tap-highlight-color:transparent}
.spin-btn:disabled{background:#e0e0d8;color:#888;cursor:default}
.winner-box{text-align:center;min-height:56px;margin-bottom:16px}
.winner-name{font-size:24px;font-weight:600;color:#533AB7;animation:popIn .3s ease}
.winner-badge-name{font-size:13px;color:#888;margin-top:2px}
@keyframes popIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
.ceremony-roster{display:flex;flex-direction:column;gap:6px;width:100%}
.ceremony-kid{display:flex;align-items:center;gap:10px;padding:9px 12px;background:white;border:0.5px solid #e0e0d8;border-radius:10px;font-size:14px}
.ceremony-kid.done{background:#E1F5EE;border-color:#9FE1CB}
.ceremony-kid.greyed{opacity:.45}
.ceremony-kid-name{font-weight:500;flex:1}
.ceremony-kid-badge{font-size:12px;color:#888}
.ceremony-reset{font-size:12px;color:#888;text-align:center;margin-top:8px;cursor:pointer;text-decoration:underline}

/* LOADING */
.loading{text-align:center;padding:40px 20px;color:#888;font-size:14px}
.empty{text-align:center;padding:40px 20px;color:#bbb;font-size:14px}

/* TOAST */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1a1a1a;color:white;padding:10px 20px;border-radius:20px;font-size:14px;z-index:999;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-card">
    <img src="https://cdn.shopify.com/s/files/1/1451/3756/files/favicon.png?v=1613591354" style="width:52px;display:block;margin:0 auto 12px;border-radius:10px">
    <h1>Camp Check-In</h1>
    <p>Sign in with your 4Cats studio account</p>
    <input type="email" id="login-email" placeholder="Email" autocomplete="email">
    <input type="password" id="login-password" placeholder="Password" autocomplete="current-password">
    <button onclick="doLogin()">Sign In</button>
    <div class="error-msg" id="login-error"></div>
  </div>
</div>

<!-- APP -->
<div id="app-screen">
  <div class="app-header">
    <div class="header-row1">
      <div>
        <div class="header-title">🎨 Camp Check-In</div>
        <div class="header-sub" id="studio-label">Loading…</div>
      </div>
      <button onclick="doSignOut()" style="background:none;border:0.5px solid #d0d0c8;border-radius:8px;padding:6px 12px;font-size:13px;cursor:pointer;color:#888">Sign out</button>
    </div>
    <div class="date-nav">
      <button onclick="shiftDate(-1)">‹</button>
      <input type="date" id="date-picker" onchange="pickDate(this.value)">
      <button onclick="goToday()" class="today-btn">Today</button>
      <button onclick="shiftDate(1)">›</button>
    </div>
  </div>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('checkin',this)">✓ Check-In</button>
    <button class="tab-btn" onclick="switchTab('ceremony-am',this)">🌅 AM Ceremony</button>
    <button class="tab-btn" onclick="switchTab('ceremony-pm',this)">🌇 PM Ceremony</button>
  </div>

  <!-- CHECK-IN TAB -->
  <div id="tab-checkin" class="tab-content active">
    <div id="checkin-content"><div class="loading">Loading…</div></div>
  </div>

  <!-- AM CEREMONY TAB -->
  <div id="tab-ceremony-am" class="tab-content">
    <div class="ceremony-wrap">
      <div class="ceremony-group" id="am-ceremony-wrap">
        <div class="ceremony-group-title">🌅 Morning Ceremony <span class="ceremony-group-time">11:30 am · Half Day MORNING</span></div>
        <div class="wheel-wrap">
          <div class="wheel-pointer"></div>
          <canvas id="canvas-am" width="320" height="320"></canvas>
        </div>
        <button class="spin-btn" id="spin-am" onclick="spin('am')">Spin the Wheel!</button>
        <div class="winner-box" id="winner-am"></div>
        <div class="ceremony-roster" id="roster-am"></div>
        <div class="ceremony-reset" onclick="resetCeremony('am')">Reset wheel</div>
      </div>
    </div>
  </div>

  <!-- PM CEREMONY TAB -->
  <div id="tab-ceremony-pm" class="tab-content">
    <div class="ceremony-wrap">
      <div class="ceremony-group" id="pm-ceremony-wrap">
        <div class="ceremony-group-title">🌇 Afternoon Ceremony <span class="ceremony-group-time">2:30 pm · Full Day + Half Day AFTERNOON</span></div>
        <div class="wheel-wrap">
          <div class="wheel-pointer"></div>
          <canvas id="canvas-pm" width="320" height="320"></canvas>
        </div>
        <button class="spin-btn" id="spin-pm" onclick="spin('pm')">Spin the Wheel!</button>
        <div class="winner-box" id="winner-pm"></div>
        <div class="ceremony-roster" id="roster-pm"></div>
        <div class="ceremony-reset" onclick="resetCeremony('pm')">Reset wheel</div>
      </div>
    </div>
  </div>
</div>

<!-- MEDICAL MODAL -->
<div class="modal-overlay" id="medical-modal" onclick="if(event.target===this)closeMedical()">
  <div class="modal-card">
    <h3 id="modal-child-name">Child Info</h3>
    <div id="modal-body"></div>
    <button class="modal-close" onclick="closeMedical()">Close</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const SUPABASE_URL = 'https://snxibhbhhchjthfmjtaj.supabase.co'
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNueGliaGJoaGNoanRoZm1qdGFqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcwNTk2ODAsImV4cCI6MjA5MjYzNTY4MH0.K-89Mx4SxU6N1hMmtK6Q79rWAtk6VTN9b5wemQxcZVA'
const { createClient } = supabase
const sb = createClient(SUPABASE_URL, SUPABASE_KEY)

const BADGES = [
  'Artist Eyes','Ball of Energy','Best Friend Tip','Brave','Caring',
  'Colour Master','Concentration','Curiosity','Drawing Champ','Etiquette',
  'Friendship','Happiness','Helping Hand','Historian','Imagination',
  'Inspiration','Junior Instructor','Leadership','Listening','Make Magic',
  'Patience','Purr-fect','Safety','Squeaky Clean','Storyteller',
  'Superstar','The Thinker','Zen'
]

const WHEEL_FILLS = ['#EEEDFE','#E1F5EE','#FAECE7','#E6F1FB','#EAF3DE','#FAEEDA','#FBEAF0','#EDF8FF','#FEF3C7','#FCE7F3']
const WHEEL_STROKES = ['#7F77DD','#1D9E75','#D85A30','#378ADD','#639922','#BA7517','#D4537E','#185FA5','#D97706','#DB2777']

let currentUser = null
let currentStudioId = null
let currentDate = new Date()
let curriculumData = []
let allChildren = []      // [{name, orderName, sessionId, sessionTitle, sessionGroup, dob, age, walkHome, medical, aftercare, earlyArrival, phone, emergency, tallyId, attendanceChecked, table, badge, awardedBadges}]
let badgeHistory = {}     // keyed by orderName|camperName -> array of badge names
let spinAngles = { am: 0, pm: 0 }
let spinning = { am: false, pm: false }
let ceremonyDone = { am: [], pm: [] }
let sortKey = 'name', sortDir = 1

// ── AUTH ──────────────────────────────────────────────────────────
async function doLogin() {
  const email = document.getElementById('login-email').value.trim()
  const pass  = document.getElementById('login-password').value
  const errEl = document.getElementById('login-error')
  errEl.style.display = 'none'
  const { data, error } = await sb.auth.signInWithPassword({ email, password: pass })
  if (error) { errEl.textContent = error.message; errEl.style.display = 'block'; return }
  currentUser = data.user
  await initApp()
}

async function doSignOut() {
  await sb.auth.signOut()
  document.getElementById('login-screen').style.display = 'flex'
  document.getElementById('app-screen').style.display = 'none'
  currentUser = null; currentStudioId = null; allChildren = []
}

sb.auth.onAuthStateChange(async (event, session) => {
  if (session?.user && !currentUser) { currentUser = session.user; await initApp() }
})

async function initApp() {
  const { data: mapping } = await sb.from('studio_users').select('studio_id').eq('user_id', currentUser.id).single()
  if (!mapping) { alert('No studio linked. Contact home office.'); return }
  const { data: studio } = await sb.from('studios').select('name, city, province').eq('id', mapping.studio_id).single()
  currentStudioId = mapping.studio_id
  document.getElementById('studio-label').textContent = (studio?.name || '') + (studio?.city ? ' · ' + studio.city : '')
  document.getElementById('login-screen').style.display = 'none'
  document.getElementById('app-screen').style.display = 'block'
  await loadCurriculumData()
  syncDatePicker()
  await loadDay()
}

// ── DATE NAV ─────────────────────────────────────────────────────
function dateStr(d) { return d.toLocaleDateString('en-CA') }
function addDays(d, n) { const r = new Date(d); r.setDate(r.getDate() + n); return r }
function shiftDate(n) { currentDate = addDays(currentDate, n); syncDatePicker(); loadDay() }
function pickDate(v) { currentDate = new Date(v + 'T12:00:00'); syncDatePicker(); loadDay() }
function goToday() { currentDate = new Date(); syncDatePicker(); loadDay() }
function syncDatePicker() { document.getElementById('date-picker').value = dateStr(currentDate) }

// ── SESSION GROUP ─────────────────────────────────────────────────
function sessionGroup(title) {
  const t = (title || '').toLowerCase()
  if (t.includes('half day morning') || t.includes('half-day morning')) return 'am'
  if (t.includes('half day afternoon') || t.includes('half-day afternoon')) return 'pm'
  if (t.includes('full day') || t.includes('full-day')) return 'fd'  // fd goes to PM ceremony
  return 'fd'
}
function ceremonyFor(group) { return group === 'am' ? 'am' : 'pm' }

// ── CURRICULUM ────────────────────────────────────────────────────
async function loadCurriculumData() {
  const { data } = await sb.from('curriculum_weeks').select('*')
  curriculumData = data || []
}

function getCurriculumLinks(sessionTitle, sessionDate) {
  const titleLower = (sessionTitle || '').toLowerCase()
  const fixed = curriculumData.find(r =>
    r.session_type_key && !r.week_start &&
    titleLower.includes(r.session_type_key.toLowerCase())
  )
  if (fixed && (fixed.website_url || fixed.curriculum_url)) return fixed
  const weekly = curriculumData.find(r =>
    r.week_start && r.week_end &&
    sessionDate >= r.week_start && sessionDate <= r.week_end
  )
  return weekly || null
}

// ── LOAD DAY ──────────────────────────────────────────────────────
async function loadDay() {
  document.getElementById('checkin-content').innerHTML = '<div class="loading">Loading…</div>'
  allChildren = []

  const today = dateStr(currentDate)

  // 1. Load camp sessions for this studio + date
  const { data: sessions } = await sb.from('sessions')
    .select('id, title, session_time, session_notes, spaces_left_cache')
    .eq('studio_id', currentStudioId)
    .eq('session_date', today)
    .order('session_time')

  const campSessions = (sessions || []).filter(s => {
    const t = (s.title || '').toLowerCase()
    return t.includes('camp') || t.includes('pa day') || t.includes('pd day') || t.includes('no school')
  })

  if (!campSessions.length) {
    document.getElementById('checkin-content').innerHTML = '<div class="empty">No camp sessions found for this date.</div>'
    renderWheels()
    return
  }

  const sessionIds = campSessions.map(s => s.id)

  // 2. Load bookings
  const { data: bookings } = await sb.from('bookings')
    .select('id, session_id, customer_name, customer_email, customer_phone, shopify_order_name, qty, raw_payload, event_date, order_note, aftercare, early_arrival, returned_at')
    .in('session_id', sessionIds)

  const activeBookings = (bookings || []).filter(b => !(b.returned_at && (b.qty || 0) === 0))
  const orderNames = [...new Set(activeBookings.map(b => b.shopify_order_name).filter(Boolean))]

  // 3. Load tally registrations
  let tallyMap = {}
  if (orderNames.length) {
    const { data: tally } = await sb.from('tally_registrations').select('*').in('shopify_order_name', orderNames)
    ;(tally || []).forEach(t => {
      const k = t.shopify_order_name
      if (!tallyMap[k]) tallyMap[k] = []
      tallyMap[k].push(t)
    })
  }

  // 4. Load attendance
  let attendanceMap = {}
  if (sessionIds.length) {
    const { data: att } = await sb.from('attendance')
      .select('session_id, shopify_order_name, camper_name, attended')
      .in('session_id', sessionIds)
    ;(att || []).forEach(a => {
      attendanceMap[`${a.shopify_order_name}|${(a.camper_name||'').toLowerCase().trim()}`] = a
    })
  }

  // 5. Load badge history for all order names
  badgeHistory = {}
  if (orderNames.length) {
    const { data: badges } = await sb.from('camp_daily_badges')
      .select('order_name, camper_name, badge_name, session_date')
      .in('order_name', orderNames)
    ;(badges || []).forEach(b => {
      const k = `${b.order_name}|${(b.camper_name||'').toLowerCase().trim()}`
      if (!badgeHistory[k]) badgeHistory[k] = []
      badgeHistory[k].push({ badge: b.badge_name, date: b.session_date })
    })
  }

  // 6. Build allChildren from bookings + tally
  campSessions.forEach(session => {
    const group = sessionGroup(session.title)
    const sessionBookings = activeBookings.filter(b => b.session_id === session.id)

    sessionBookings.forEach(b => {
      const props = parseLineItemProps(b.raw_payload, b.event_date)
      let participants = props
        .filter(p => p.name?.toLowerCase().startsWith('participant'))
        .sort((a, z) => a.name.localeCompare(z.name))
        .map(p => {
          const name = p.value.split('|')[0]?.trim() || p.value
          const dobMatch = p.value.match(/DOB:\s*(\d{4}-\d{2}-\d{2})/)
          const dob = dobMatch ? dobMatch[1] : null
          const tRows = (tallyMap[b.shopify_order_name] || [])
          const tally = tRows.find(t => t.camper_name?.toLowerCase().trim() === name.toLowerCase().trim())
          return { name, dob, tally }
        })

      if (!participants.length) {
        const tRows = (tallyMap[b.shopify_order_name] || [])
        participants = tRows.map(t => ({ name: t.camper_name, dob: null, tally: t }))
      }

      if (!participants.length) {
        participants = [{ name: '', dob: null, tally: null }]
      }

      participants.forEach(p => {
        const t = p.tally
        const camperName = p.name || ''
        const attKey = `${b.shopify_order_name}|${camperName.toLowerCase().trim()}`
        const att = attendanceMap[attKey]
        const badgeKey = `${b.shopify_order_name}|${camperName.toLowerCase().trim()}`
        const todayBadge = (badgeHistory[badgeKey] || []).find(bh => bh.date === today)

        allChildren.push({
          _uid: `${b.shopify_order_name}-${camperName.replace(/\s/g,'_')}`,
          name: camperName,
          dob: p.dob || null,
          age: t?.camper_age || null,
          sessionId: session.id,
          sessionTitle: session.title,
          sessionGroup: group,
          sessionNotes: session.session_notes || '',
          orderName: b.shopify_order_name,
          registeredBy: b.customer_name || '',
          phone: t?.parent_phone || b.customer_phone || getPayloadPhone(b.raw_payload) || '',
          emergency: (t?.emergency_contact_name || '') + (t?.emergency_contact_phone ? ' ' + t.emergency_contact_phone : ''),
          walkHome: t?.walk_home || false,
          medical: t?.medical_notes || '',
          aftercare: t?.aftercare || b.aftercare || false,
          earlyArrival: b.early_arrival || false,
          tallyId: t?.id || null,
          attendanceChecked: att?.attended || false,
          table: '',        // we'll store locally
          badge: todayBadge?.badge || '',
          awardedBadges: (badgeHistory[badgeKey] || []).map(bh => bh.badge),
        })
      })
    })
  })

  // Deduplicate by orderName+name (same child in multiple sessions is rare but possible)
  const seen = new Set()
  allChildren = allChildren.filter(c => {
    const k = `${c.orderName}|${c.name.toLowerCase().trim()}`
    if (seen.has(k)) return false
    seen.add(k)
    return true
  })

  // Build day plan info from sessions
  const dayPlanText = campSessions.map(s => s.session_notes).filter(Boolean).join(' · ') || ''

  renderCheckin(dayPlanText, campSessions)
  renderWheels()
}

// ── RENDER CHECK-IN ───────────────────────────────────────────────
function getSorted() {
  const q = (document.getElementById('search-input')?.value || '').toLowerCase()
  let list = allChildren.filter(c =>
    !q || c.name.toLowerCase().includes(q) || c.registeredBy.toLowerCase().includes(q)
  )
  list.sort((a, b) => {
    let av = sortKey === 'name' ? a.name :
             sortKey === 'parent' ? a.registeredBy :
             sortKey === 'table' ? (parseInt(a.table) || 999) : a.name
    let bv = sortKey === 'name' ? b.name :
             sortKey === 'parent' ? b.registeredBy :
             sortKey === 'table' ? (parseInt(b.table) || 999) : b.name
    if (av < bv) return -1 * sortDir
    if (av > bv) return 1 * sortDir
    return 0
  })
  return list
}

function setSort(key) {
  if (sortKey === key) sortDir *= -1; else { sortKey = key; sortDir = 1 }
  renderCheckinList()
}

function renderCheckin(dayPlanText, campSessions) {
  const checkedIn = allChildren.filter(c => c.attendanceChecked).length
  const total = allChildren.length
  const aftercareCount = allChildren.filter(c => c.aftercare).length
  const badgedCount = allChildren.filter(c => c.badge).length

  let html = ''

  // Stats
  html += `<div class="stats-bar">
    <div class="stat-card"><div class="stat-num">${total}</div><div class="stat-label">Registered</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#3B6D11">${checkedIn}</div><div class="stat-label">Checked In</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#92400E">${aftercareCount}</div><div class="stat-label">Aftercare</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#533AB7">${badgedCount}</div><div class="stat-label">Badged</div></div>
  </div>`

  // Day plan
  if (dayPlanText || campSessions?.length) {
    const today = dateStr(currentDate)
    // Gather unique curriculum links across all camp sessions
    const links = []
    ;(campSessions || []).forEach(s => {
      const cl = getCurriculumLinks(s.title, today)
      if (cl?.curriculum_url && !links.find(l => l.url === cl.curriculum_url)) {
        links.push({ url: cl.curriculum_url, label: '📋 Curriculum' })
      }
      if (cl?.website_url && !links.find(l => l.url === cl.website_url)) {
        links.push({ url: cl.website_url, label: '🌐 Website' })
      }
    })
    const linkHtml = links.map(l =>
      `<a href="${l.url}" target="_blank" style="font-size:13px;color:#2e7d32;text-decoration:none;padding:5px 12px;border:0.5px solid #a5d6a7;border-radius:8px;background:#e8f5e9;white-space:nowrap">${l.label}</a>`
    ).join('')
    html += `<div class="day-plan-banner">
      <div style="flex:1">
        <div class="day-plan-label">Today's Plan</div>
        <div class="day-plan-text">${dayPlanText || 'Camp day'}</div>
      </div>
      ${linkHtml ? `<div style="display:flex;gap:6px;flex-wrap:wrap">${linkHtml}</div>` : ''}
    </div>`
  }

  // Controls
  html += `<div class="controls-row">
    <input class="search-input" id="search-input" type="search" placeholder="Search child or parent…" oninput="renderCheckinList()">
    <div class="sort-group">
      <button class="sort-btn ${sortKey==='name'?'active':''}" onclick="setSort('name')">Name</button>
      <button class="sort-btn ${sortKey==='parent'?'active':''}" onclick="setSort('parent')">Parent</button>
      <button class="sort-btn ${sortKey==='table'?'active':''}" onclick="setSort('table')">Table</button>
    </div>
  </div>`

  html += `<div class="roster-list" id="roster-list"></div>`

  document.getElementById('checkin-content').innerHTML = html
  renderCheckinList()
}

function renderCheckinList() {
  const list = getSorted()
  const el = document.getElementById('roster-list')
  if (!el) return
  if (!list.length) { el.innerHTML = '<div class="empty">No children found.</div>'; return }

  el.innerHTML = list.map(c => {
