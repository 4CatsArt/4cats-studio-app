      const sel = c.badge === b ? 'selected' : ''
      const cls = prev && c.badge !== b ? 'class="previously-awarded"' : ''
      const label = prev && c.badge !== b ? `${b} ✓` : b
      return `<option value="${b}" ${sel} ${cls}>${label}</option>`
    }).join('')

    return `<div class="roster-card${c.attendanceChecked?' checked-in':''}${c.medical?' has-medical':''}" id="card-${uid}">
      <div class="roster-card-header">
        <button class="check-btn${c.attendanceChecked?' checked':''}" onclick="toggleCheck('${uid}')">${c.attendanceChecked?'✓':''}</button>
