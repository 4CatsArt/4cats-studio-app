// ── WHEEL ─────────────────────────────────────────────────────────
function wheelKids(group) {
  // AM wheel: only AM kids who are checked in
  // PM wheel: Full Day + PM kids who are checked in
  return allChildren.filter(c => {
    if (!c.attendanceChecked) return false
    if (!c.name) return false
    if (group === 'am') return c.sessionGroup === 'am'
    return c.sessionGroup === 'fd' || c.sessionGroup === 'pm'
  })
}

function drawWheel(group, highlightIdx = -1, angle = 0) {
  const canvas = document.getElementById(`canvas-${group}`)
  if (!canvas) return
  const ctx = canvas.getContext('2d')
  const kids = wheelKids(group)
  const done = ceremonyDone[group]
  ctx.clearRect(0, 0, 320, 320)
  const cx = 160, cy = 160, r = 150

  if (!kids.length) {
    ctx.fillStyle = '#bbb'
    ctx.font = '13px -apple-system, sans-serif'
    ctx.textAlign = 'center'
    ctx.fillText('Check in kids to', cx, cy - 8)
    ctx.fillText('populate the wheel', cx, cy + 12)
    return
  }

  const n = kids.length
  const arc = (2 * Math.PI) / n
  kids.forEach((k, i) => {
    const isGreyed = done.includes(k._uid)
    const start = angle + i * arc - Math.PI / 2
    const end = start + arc
    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.arc(cx, cy, r, start, end); ctx.closePath()
    ctx.fillStyle = isGreyed ? '#e8e8e2' : (highlightIdx === i ? WHEEL_STROKES[i % WHEEL_STROKES.length] : WHEEL_FILLS[i % WHEEL_FILLS.length])
    ctx.fill()
    ctx.strokeStyle = isGreyed ? '#ccc' : WHEEL_STROKES[i % WHEEL_STROKES.length]
    ctx.lineWidth = 1.5; ctx.stroke()
    ctx.save()
    ctx.translate(cx, cy)
    ctx.rotate(start + arc / 2)
    ctx.textAlign = 'right'
    const firstName = (k.name || '?').split(' ')[0]
    ctx.fillStyle = isGreyed ? '#aaa' : (highlightIdx === i ? 'white' : '#2C2C2A')
    ctx.font = `${highlightIdx === i ? '600 ' : ''}13px -apple-system, sans-serif`
    ctx.fillText(firstName, r - 10, 5)
    ctx.restore()
  })

  // Center circle
  ctx.beginPath(); ctx.arc(cx, cy, 16, 0, 2 * Math.PI)
  ctx.fillStyle = 'white'; ctx.fill()
  ctx.strokeStyle = '#e0e0d8'; ctx.lineWidth = 1; ctx.stroke()
}

function renderWheels() {
  drawWheel('am', -1, spinAngles.am)
  drawWheel('pm', -1, spinAngles.pm)
  renderCeremonyRosters()
}

function renderCeremonyRosters() {
  ;['am', 'pm'].forEach(group => {
    const el = document.getElementById(`roster-${group}`)
    if (!el) return
    const kids = wheelKids(group)
    const done = ceremonyDone[group]
    if (!kids.length) { el.innerHTML = '<div class="empty" style="font-size:13px">No checked-in kids yet.</div>'; return }
    el.innerHTML = kids.map(k => {
      const isDone = done.includes(k._uid)
      const todayBadge = k.badge ? `<span style="font-size:11px;color:#533AB7">🏅 ${k.badge}</span>` : ''
      return `<div class="ceremony-kid${isDone ? ' done' : ''}">
        <span style="font-size:18px">${isDone ? '✅' : '⭕'}</span>
        <div class="ceremony-kid-name">${k.name}</div>
        ${isDone ? todayBadge : '<span class="ceremony-kid-badge">Waiting…</span>'}
        ${isDone ? `<span class="ceremony-reset" style="font-size:11px;margin-top:0" onclick="undoCeremony('${group}','${k._uid}')">undo</span>` : ''}
      </div>`
    }).join('')
  })
}

function spin(group) {
  const kids = wheelKids(group)
  const remaining = kids.filter(k => !ceremonyDone[group].includes(k._uid))
  if (!kids.length || spinning[group]) return
  if (!remaining.length) {
    document.getElementById(`winner-${group}`).innerHTML = '<div style="font-size:14px;color:#888">🎉 Everyone has been celebrated!</div>'
    return
  }
  spinning[group] = true
  document.getElementById(`spin-${group}`).disabled = true

  const totalSpin = 6 * 2 * Math.PI + Math.random() * 2 * Math.PI
  const duration = 3500
  const start = performance.now()
  const startAngle = spinAngles[group]

  function animate(now) {
    const t = Math.min((now - start) / duration, 1)
    const ease = 1 - Math.pow(1 - t, 4)
    spinAngles[group] = startAngle + totalSpin * ease
    const n = kids.length
    const arc = (2 * Math.PI) / n
    const normalized = ((-spinAngles[group] % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI)
    const idx = Math.floor(normalized / arc)
    drawWheel(group, idx, spinAngles[group])
    if (t < 1) { requestAnimationFrame(animate) } else {
      spinning[group] = false
      document.getElementById(`spin-${group}`).disabled = false
      const winner = kids[idx]
      if (winner) {
        if (!ceremonyDone[group].includes(winner._uid)) ceremonyDone[group].push(winner._uid)
        const badgeDisplay = winner.badge ? `<div class="winner-badge-name">🏅 ${winner.badge}</div>` : '<div class="winner-badge-name">Amazing work today!</div>'
        document.getElementById(`winner-${group}`).innerHTML = `<div class="winner-name">${winner.name}</div>${badgeDisplay}`
      }
      renderCeremonyRosters()
      drawWheel(group, -1, spinAngles[group])
    }
  }
  requestAnimationFrame(animate)
}

function undoCeremony(group, uid) {
  ceremonyDone[group] = ceremonyDone[group].filter(x => x !== uid)
  renderCeremonyRosters()
  drawWheel(group, -1, spinAngles[group])
}

function resetCeremony(group) {
  if (!confirm('Reset this wheel? All spun names will become available again.')) return
  ceremonyDone[group] = []
  spinAngles[group] = 0
  document.getElementById(`winner-${group}`).innerHTML = ''
  renderCeremonyRosters()
  drawWheel(group, -1, 0)
}

// ── HELPERS ───────────────────────────────────────────────────────
function parseLineItemProps(rawPayload, sessionDate) {
  try {
    const payload = typeof rawPayload === 'string' ? JSON.parse(rawPayload) : rawPayload
    if (!payload?.line_items) return []
    const items = payload.line_items
    let match = items.find(li => {
      const t = (li.title || li.name || '').toLowerCase()
      if (sessionDate) {
        const d = new Date(sessionDate + 'T12:00:00')
        const monthDay = d.toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }).replace('.', '').toLowerCase()
        if (t.includes(monthDay)) return true
        const day = d.getDate()
        const suffix = day===1||day===21||day===31?'st':day===2||day===22?'nd':day===3||day===23?'rd':'th'
        if (t.includes(`${monthDay}${suffix}`)) return true
      }
      return false
    })
    if (!match) match = items[0]
    return match?.properties || []
  } catch(e) { return [] }
}

function formatDOB(dobStr, refDateStr) {
  try {
    const dob = new Date(dobStr + 'T12:00:00')
    const ref = refDateStr ? new Date(refDateStr + 'T12:00:00') : new Date()
    let age = ref.getFullYear() - dob.getFullYear()
    const m = ref.getMonth() - dob.getMonth()
    if (m < 0 || (m === 0 && ref.getDate() < dob.getDate())) age--
    const formatted = dob.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' })
    return `Age ${age} · b. ${formatted}`
  } catch(e) { return dobStr }
}

function getPayloadPhone(rawPayload) {
  try {
    const p = typeof rawPayload === 'string' ? JSON.parse(rawPayload) : rawPayload
    return p?.billing_address?.phone || p?.shipping_address?.phone || p?.customer?.phone || p?.phone || ''
  } catch { return '' }
}

function showToast(msg) {
  const t = document.getElementById('toast')
  t.textContent = msg; t.classList.add('show')
  setTimeout(() => t.classList.remove('show'), 2000)
}
