        </div>
        <div class="field-group" style="flex:1;min-width:150px">
          <div class="field-label">Today's Badge</div>
          <select class="field-input badge-select" id="badge-${uid}" onchange="updateBadge('${uid}',this.value)">
            <option value="">— No badge yet —</option>
