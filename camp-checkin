    const groupTag = c.sessionGroup === 'am'
      ? `<span class="session-tag am">AM</span>`
      : c.sessionGroup === 'fd'
      ? `<span class="session-tag fd">Full Day</span>`
      : `<span class="session-tag pm">PM</span>`
    const aftercareTag = c.aftercare ? `<span class="aftercare-tag">Aftercare</span>` : ''
    const walkTag = c.walkHome ? `<span class="walkhome-tag">Walk Home</span>` : ''
    const medIcon = c.medical ? `<span class="medical-icon" onclick="showMedical('${uid}')" title="Medical info">⚕️</span>` : ''
    const ageDisplay = c.dob ? formatDOB(c.dob, dateStr(currentDate)) : (c.age ? `Age ${c.age}` : '')

    const badgeOpts = BADGES.map(b => {
