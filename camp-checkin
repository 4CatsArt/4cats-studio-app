  })
}

function updateStatsBar() {
  const checkedIn = allChildren.filter(c => c.attendanceChecked).length
  const total = allChildren.length
  const aftercareCount = allChildren.filter(c => c.aftercare).length
  const badgedCount = allChildren.filter(c => c.badge).length
  const bar = document.querySelector('.stats-bar')
  if (!bar) return
  const nums = bar.querySelectorAll('.stat-num')
  if (nums[0]) nums[0].textContent = total
