  if (nums[2]) nums[2].textContent = aftercareCount
  if (nums[3]) nums[3].textContent = badgedCount
}

// ── INTERACTIONS ──────────────────────────────────────────────────
async function toggleCheck(uid) {
  const c = allChildren.find(x => x._uid === uid)
  if (!c) return
  c.attendanceChecked = !c.attendanceChecked
  const card = document.getElementById(`card-${uid}`)
  const btn = card?.querySelector('.check-btn')
  if (card) card.classList.toggle('checked-in', c.attendanceChecked)
  if (btn) { btn.classList.toggle('checked', c.attendanceChecked); btn.textContent = c.attendanceChecked ? '✓' : '' }
  updateStatsBar()
  renderWheels()
  // Save to attendance table
  const today = dateStr(currentDate)
  const { data: existing } = await sb.from('attendance').select('id')
    .eq('session_id', c.sessionId)
    .eq('shopify_order_name', c.orderName)
    .eq('camper_name', c.name)
    .single()
  if (existing) {
    await sb.from('attendance').update({ attended: c.attendanceChecked, attended_date: today }).eq('id', existing.id)
  } else {
    await sb.from('attendance').insert({ session_id: c.sessionId, shopify_order_name: c.orderName, camper_name: c.name, attended: c.attendanceChecked, attended_date: today })
  }
}

function updateTable(uid, val) {
  const c = allChildren.find(x => x._uid === uid)
  if (c) c.table = val
}

function updateBadge(uid, val) {
  const c = allChildren.find(x => x._uid === uid)
  if (c) c.badge = val
}

async function saveRow(uid) {
  const c = allChildren.find(x => x._uid === uid)
  if (!c) return
  const btn = document.getElementById(`savebtn-${uid}`)
  if (btn) { btn.textContent = 'Saving…'; btn.disabled = true }

  const today = dateStr(currentDate)

  // Save badge if set
  if (c.badge && c.name) {
    const badgeKey = `${c.orderName}|${c.name.toLowerCase().trim()}`
    const todayEntry = (badgeHistory[badgeKey] || []).find(bh => bh.date === today)

    if (todayEntry && todayEntry.badge !== c.badge) {
      // Update today's badge
      await sb.from('camp_daily_badges')
        .update({ badge_name: c.badge })
        .eq('order_name', c.orderName)
        .eq('camper_name', c.name)
        .eq('session_date', today)
    } else if (!todayEntry) {
      // Insert new
      await sb.from('camp_daily_badges').insert({
        session_date: today,
        studio_id: currentStudioId,
        camper_name: c.name,
        order_name: c.orderName,
        badge_name: c.badge
      })
    }

    // Update local history
    if (!badgeHistory[badgeKey]) badgeHistory[badgeKey] = []
    const idx = badgeHistory[badgeKey].findIndex(bh => bh.date === today)
    if (idx >= 0) badgeHistory[badgeKey][idx].badge = c.badge
    else badgeHistory[badgeKey].push({ badge: c.badge, date: today })

    // Update awardedBadges
    if (!c.awardedBadges.includes(c.badge)) c.awardedBadges.push(c.badge)
  }

  // Save tally row (name, table in medical_notes supplement, etc.)
  if (c.name) {
    const payload = {
      shopify_order_name: c.orderName,
      camper_name: c.name,
      walk_home: c.walkHome,
      medical_notes: c.medical || null,
      aftercare: c.aftercare,
      parent_phone: c.phone || null,
    }
    if (c.tallyId) {
      await sb.from('tally_registrations').update(payload).eq('id', c.tallyId)
    } else {
      const { data: newRow } = await sb.from('tally_registrations').insert(payload).select('id').single()
      if (newRow) c.tallyId = newRow.id
    }
  }

  showToast('Saved ✓')
  if (btn) {
    btn.textContent = 'Saved ✓'; btn.classList.add('saved')
    setTimeout(() => { btn.textContent = 'Save'; btn.classList.remove('saved'); btn.disabled = false }, 2000)
  }

  updateStatsBar()
  renderWheels()
}

